# Slack tokens. Create these after importing slack-manifest.yaml.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-socket-mode-token

# The ID between /d/ and /edit in the Google Sheet URL.
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id

# For local development, use the full path to the service-account JSON file,
# not the directory containing it.
# On Google Cloud, omit it and use Application Default Credentials instead.
GOOGLE_SERVICE_ACCOUNT_FILE=C:\path\to\service-account.json

# Display sheet times and interpret Slack date/time input in this timezone.
INVENTORY_TIMEZONE=America/New_York

# Optional sheet tab names.
ITEMS_SHEET=Items
RESERVATIONS_SHEET=Reservations

# Optional comma-separated allowlists. Leave blank to allow the whole workspace.
ALLOWED_CHANNEL_IDS=
ALLOWED_USER_IDS=

# Durable local request buffer. Defaults are conservative for Google Sheets.
# Inventory maintainers never need to open this file; Sheets stays user-facing.
RESERVATION_QUEUE_DATABASE=.inventory_bot/reservation_queue.sqlite3
RESERVATION_QUEUE_RATE_PER_MINUTE=4
RESERVATION_QUEUE_MAX_ATTEMPTS=8
RESERVATION_QUEUE_RETENTION_DAYS=30

# Cache item-picker searches briefly so typing does not repeatedly read Sheets.
ITEM_PICKER_CACHE_SECONDS=15
